generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProgressStatus {
  NOT_STARTED
  LEARNING
  COMPLETED
  NEEDS_REVISION
  MASTERED
}

enum ResourceType {
  YOUTUBE_VIDEO
  YOUTUBE_PLAYLIST
  WEBSITE
  PDF
  MARKDOWN
  TXT
  IMAGE
  GENERIC_FILE
  CODE
  BOOKMARK
}

enum ResourceLocationType {
  INBOX
  EXAM
  SUBJECT
  CHAPTER
  TOPIC
}

enum DocumentProcessingStatus {
  UPLOADED
  PROCESSING
  EXTRACTED
  ANALYZED
  READY_FOR_REVIEW
  APPROVED
  FAILED
}

enum SyllabusDocumentType {
  FULL_EXAM_SYLLABUS
  SUBJECT_SYLLABUS
  CHAPTER_OR_TOPIC_DOCUMENT
  UNKNOWN
}

enum ResourceProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  exams        Exam[]
  subjects     Subject[]
  chapters     Chapter[]
  topics       Topic[]
  topicProgress TopicProgress[]
  documents    Document[]
  resources    Resource[]
  notes        Note[]

  @@map("users")
}

model Exam {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  code           String?
  targetDate     DateTime?
  targetScore    Float?
  targetRank     Int?
  dailyGoalHours Float     @default(4.0)
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subjects       Subject[]
  documents      Document[]
  resources      Resource[]
  notes          Note[]

  @@index([userId])
  @@map("exams")
}

model Document {
  id                 String                   @id @default(uuid())
  userId             String
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId             String?
  exam               Exam?                    @relation(fields: [examId], references: [id], onDelete: SetNull)
  filename           String
  mimeType           String
  storageKey         String
  sizeBytes          Int
  status             DocumentProcessingStatus @default(UPLOADED)
  documentType       SyllabusDocumentType?
  aiConfidence       Float?
  extractedText      String?                  @db.Text
  extractedHierarchy Json?
  warnings           Json?
  errorMessage       String?                  @db.Text
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([userId])
  @@index([examId])
  @@map("documents")
}

model Subject {
  id         String   @id @default(uuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  code       String?
  colorHex   String?  @default("#3B82F6")
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  chapters   Chapter[]
  resources  Resource[]
  notes      Note[]

  @@index([examId])
  @@index([userId])
  @@map("subjects")
}

model Chapter {
  id         String   @id @default(uuid())
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  topics     Topic[]
  resources  Resource[]
  notes      Note[]

  @@index([subjectId])
  @@index([userId])
  @@map("chapters")
}

model Topic {
  id         String   @id @default(uuid())
  chapterId  String
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Topic?   @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subtopics  Topic[]  @relation("TopicHierarchy")
  name       String
  orderIndex Int      @default(0)
  path       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  progress   TopicProgress?
  resources  Resource[]
  notes      Note[]

  @@index([chapterId])
  @@index([parentId])
  @@index([userId])
  @@map("topics")
}

model TopicProgress {
  id                 String         @id @default(uuid())
  topicId            String         @unique
  topic              Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             ProgressStatus @default(NOT_STARTED)
  confidenceScore    Int            @default(1)
  masteryScore       Float          @default(0.0)
  totalStudyTimeSec  Int            @default(0)
  lastStudiedAt      DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([userId])
  @@index([topicId])
  @@map("topic_progress")
}

model Resource {
  id           String                   @id @default(uuid())
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationType ResourceLocationType     @default(INBOX)
  type         ResourceType
  title        String
  description  String?                  @db.Text
  url          String?                  @db.Text
  filename     String?
  mimeType     String?
  sizeBytes    Int?
  storageKey   String?
  thumbnailUrl String?                  @db.Text
  status       ResourceProcessingStatus @default(READY)
  provider     String?
  externalId   String?
  metadata     Json?
  isCompleted  Boolean                  @default(false)
  completedAt  DateTime?

  examId       String?
  exam         Exam?                    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      Subject?                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterId    String?
  chapter      Chapter?                 @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  topicId      String?
  topic        Topic?                   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  noteReferences NoteResource[]

  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([userId])
  @@index([examId])
  @@index([subjectId])
  @@index([chapterId])
  @@index([topicId])
  @@index([locationType])
  @@index([type])
  @@map("resources")
}

model Note {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  content       String         @db.Text
  contentFormat String         @default("MARKDOWN")
  isPinned      Boolean        @default(false)
  isArchived    Boolean        @default(false)

  examId        String?
  exam          Exam?          @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId     String?
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterId     String?
  chapter       Chapter?       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  topicId       String?
  topic         Topic?         @relation(fields: [topicId], references: [id], onDelete: Cascade)

  resources     NoteResource[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, updatedAt])
  @@index([userId, isPinned])
  @@index([userId, isArchived])
  @@index([userId, examId])
  @@index([userId, subjectId])
  @@index([userId, chapterId])
  @@index([userId, topicId])
  @@map("notes")
}

model NoteResource {
  noteId     String
  note       Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([noteId, resourceId])
  @@index([noteId])
  @@index([resourceId])
  @@map("note_resources")
}
