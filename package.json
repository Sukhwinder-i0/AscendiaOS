{
  "name": "ascendiaos-monorepo",
  "version": "1.0.0",
  "description": "AscendiaOS - End-to-End Smart Exam & Study Infrastructure Monorepo",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "sukhwinder-i0",
    "url": "https://github.com/sukhwinder-i0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sukhwinder-i0/os4study.git"
  },
  "scripts": {
    "dev:api": "pnpm --filter @ascendiaos/api start:dev",
    "dev:web": "pnpm --filter @ascendiaos/web dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "db:docker": "docker compose -f docker/docker-compose.yml up -d",
    "db:generate": "pnpm --filter @ascendiaos/database generate",
    "db:migrate": "pnpm --filter @ascendiaos/database migrate",
    "db:seed": "pnpm --filter @ascendiaos/database seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
