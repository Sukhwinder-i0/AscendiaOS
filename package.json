{
  "name": "studyos-monorepo",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @studyos/api start:dev",
    "dev:web": "pnpm --filter @studyos/web dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "db:docker": "docker compose -f docker/docker-compose.yml up -d",
    "db:generate": "pnpm --filter @studyos/database generate",
    "db:migrate": "pnpm --filter @studyos/database migrate",
    "db:seed": "pnpm --filter @studyos/database seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
