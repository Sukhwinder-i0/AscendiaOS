# ==============================================================================
# AscendiaOS Monorepo - Global Environment Configuration Template
# Created by sukhwinder-i0 (https://github.com/sukhwinder-i0)
# ==============================================================================
# Copy this file to `.env` in the project root directory and update values as needed.
# Do NOT commit actual secrets or credentials to public version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# APP & ENVIRONMENT SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# Database URL format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
# Special characters in passwords must be URL-encoded (e.g. '@' -> '%40', '#' -> '%23')
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/ascendiaos?schema=public"

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# JWT secret key for signing user session tokens (min 32 random characters in production)
JWT_SECRET="ascendiaos-dev-secret-key-replace-in-production-with-secure-32byte-hex-string"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# WEB FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# AI PROVIDER CONFIGURATION
# Options: 'mock' (local testing without API keys), 'openai', 'gemini'
# ------------------------------------------------------------------------------
AI_PROVIDER=mock
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# FILE STORAGE CONFIGURATION
# Options: 'local' (filesystem), 's3' (AWS S3 / MinIO / Cloudflare R2)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH="./uploads"

# AWS S3 / Compatible Storage (Required if STORAGE_PROVIDER=s3)
S3_BUCKET="ascendiaos-storage"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
