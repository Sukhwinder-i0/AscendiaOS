# ==============================================================================
# AscendiaOS Web Client - Environment Configuration Template
# Created by sukhwinder-i0 (https://github.com/sukhwinder-i0)
# ==============================================================================
# Copy this file to `.env.local` inside `apps/web/` for local client configuration.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser client bundle.
# ==============================================================================

# Backend API Endpoint URL
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Web Application Root URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Client Features / Analytics
NEXT_PUBLIC_APP_NAME="AscendiaOS"
NEXT_PUBLIC_APP_VERSION="1.0.0"
