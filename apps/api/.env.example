# ==============================================================================
# AscendiaOS API Service - Environment Configuration Template
# Created by sukhwinder-i0 (https://github.com/sukhwinder-i0)
# ==============================================================================
# Copy this file to `.env` inside `apps/api/` for environment overrides.
# ==============================================================================

# Server Environment & Network
NODE_ENV=development
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Database Connection URL (PostgreSQL + Prisma)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/ascendiaos?schema=public"

# Authentication Secrets
JWT_SECRET="studyos-api-jwt-secret-replace-in-production-with-random-secure-key"
JWT_EXPIRES_IN="7d"

# AI Provider Configuration ('mock' | 'openai')
AI_PROVIDER=mock
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Storage Configuration ('local' | 's3')
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH="./uploads"

# AWS S3 / Compatible Object Storage (Required if STORAGE_PROVIDER=s3)
S3_BUCKET="ascendiaos-storage"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
